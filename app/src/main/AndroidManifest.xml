<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
        <package android:name="vn.vietmap.live" />
        <package android:name="vn.vietmap.live.v2" />
    </queries>

    <application
        android:name=".CarHudApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_carhud"
        android:label="CarHUD"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CarViewCarAppService"
            android:label="CarHUD"
            android:icon="@drawable/ic_carhud"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <service
            android:name=".SpeedBubbleService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
